    "node": ">=22.19.0"
  },
  "scripts": {
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "test:saas": "node scripts/test-saas-control-plane.cjs",
    "test:knowledge": "node scripts/test-knowledge-crawl.cjs",
    "test:documents": "node scripts/test-knowledge-documents.cjs",
    "test:flow-persistence": "node scripts/test-flow-persistence.cjs",
    "test:chat-bootstrap": "node scripts/test-chat-bootstrap.cjs",
    "test:zero-trust": "node --experimental-strip-types --no-warnings scripts/test-zero-trust-onboarding.mts && node --experimental-strip-types --no-warnings scripts/test-zero-trust-service-boundaries.mts",
    "eval:rag": "node --experimental-strip-types --no-warnings scripts/eval-rag-pipeline.mts",
    "admin:bootstrap": "node scripts/bootstrap-platform-admin.cjs",
    "dev": "NODE_OPTIONS='--max-old-space-size=768 --max-semi-space-size=16' NEXT_DIST_DIR=.next-dev next dev --turbopack --disable-source-maps",
    "dev:webpack": "NODE_OPTIONS='--max-old-space-size=768 --max-semi-space-size=16' NEXT_DIST_DIR=.next-dev next dev --disable-source-maps",
    "build": "NEXT_DIST_DIR=.next next build",
    "start": "NEXT_DIST_DIR=.next next start",
    "start:memory-512": "NODE_OPTIONS='--max-old-space-size=384 --max-semi-space-size=16' NEXT_DIST_DIR=.next next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && node --experimental-strip-types --no-warnings scripts/test-bot-journey.mts && npm run test:zero-trust && npm run eval:rag && node scripts/test-chat-fast-path.cjs && npm run test:chat-bootstrap && node --experimental-strip-types --no-warnings scripts/test-bounded-cache.mts && node --no-warnings scripts/test-bulk-email-transport.mjs && node scripts/test-offering-discovery.cjs && node scripts/test-commerce-flow.cjs && node scripts/test-order-tracking-flow.cjs && node scripts/test-booking-flow.cjs && node scripts/test-restaurant-booking.cjs && node scripts/test-booking-latency-rpcs.mjs && node scripts/test-booking-addon-inventory.mjs && node scripts/test-in-app-notifications.cjs",
    "telegram:poll": "node scripts/telegram-poll.mjs"
  },

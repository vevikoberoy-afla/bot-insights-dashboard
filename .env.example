# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Application
NEXT_PUBLIC_APP_URL=
ADMIN_SECRET=
TICKET_LINK_SECRET=
DEMO_BOT_ID=
SUPER_ADMIN_EMAILS=

# AI and ingestion
GEMINI_API_KEY=
GOOGLE_AI_API_KEY=
SUMMARISE_GEMINI_API_KEY=
GOOGLE_MODEL=gemini-flash-lite-latest
FIRECRAWL_API_KEY=
FIRECRAWL_WEBHOOK_SECRET=

# Optional private ClamAV INSTREAM scanner for knowledge documents. When set,
# scanner outages reject imports. Leave unset to use structural quarantine only.
CLAMAV_HOST=
CLAMAV_PORT=3310

# Caching and jobs
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
CATALOG_ENRICHMENT_SECRET=
BULK_EMAIL_SIGNING_SECRET=

# Commerce payments (generate independently; never expose with NEXT_PUBLIC_)
# openssl rand -hex 32
PAYMENT_ENCRYPTION_KEY_HEX=
# openssl rand -base64 48
PAYMENT_HMAC_SECRET=
RAZORPAY_MASTER_KEY_ID=
RAZORPAY_MASTER_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Public widget security (comma-separated origins)
WIDGET_ALLOWED_ORIGINS=
WIDGET_SESSION_HMAC_SECRET=
# JWT registered-claim binding. Issuer defaults to
# ${NEXT_PUBLIC_SUPABASE_URL}/auth/v1 when omitted.
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
SAAS_VAULT_MASTER_KEY_V1=
SAAS_VAULT_MASTER_KEY_PREV=

# Provider webhook verification
META_APP_SECRET=
META_APP_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_WORKER_SECRET=
WHATSAPP_CLICK_SIGNING_SECRET=
WHATSAPP_GRAPH_VERSION=v21.0
DEFAULT_PHONE_COUNTRY=IN
TELEGRAM_WEBHOOK_SECRET=
CHATWOOT_WEBHOOK_SECRET=
EMAIL_WEBHOOK_SECRET=
EMAIL_ESP_WEBHOOK_SECRET=
SHOPIFY_WEBHOOK_SECRET=
CRON_SECRET=

# Optional integrations
CHATWOOT_API_KEY=
NEXT_PUBLIC_CHATWOOT_URL=
DITTOFEED_URL=
DITTOFEED_WRITE_KEY=
TILEDESK_API_URL=
TILEDESK_API_KEY=

# Bulk email transport (AWS SES HTTPS; SMTP integrations remain a fallback)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=
SES_SENDING_DOMAIN=
SES_CONFIGURATION_SET=
EMAIL_OUTBOUND_RATE=100
